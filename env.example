# Atrium environment configuration
#
# Copy this file to .env and fill in the values for your machine.
#   cp env.example .env        (Windows: copy env.example .env)
#
# Never commit .env. As you add features that need configuration, add the
# variables here too: a marker sets up your project from this file alone.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atrium

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Centre timezone. All opening hours, week boundaries and scheduled jobs are
# evaluated in this zone. Do not assume it equals the server's zone.
CENTRE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Session and authentication
# ---------------------------------------------------------------------------
# Replace this before doing anything else.
SESSION_SECRET=change-me

# ---------------------------------------------------------------------------
# Demo accounts
# ---------------------------------------------------------------------------
# The supplied seed stores hashes of passwords that were never recorded, so
# these three accounts — one of each role — are given a known password by
# `npm run migrate`. Every other seeded account keeps its original hash and is
# reached through the password-reset flow at /reset-password.
SEED_ADMIN_EMAIL=admin@atrium.local
SEED_ADMIN_PASSWORD=atrium-admin-demo
SEED_COACH_EMAIL=oscar.lindqvist@atrium.local
SEED_COACH_PASSWORD=atrium-coach-demo
SEED_PARTICIPANT_EMAIL=sofia.marino@atrium.local
SEED_PARTICIPANT_PASSWORD=atrium-participant-demo

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# `console` needs nothing installed: every message is printed in full to the
# API terminal, including password-setup links. This is the default so that a
# clean clone can see all six notification paths without any extra software.
#
# For a web inbox instead, install Mailpit (a single binary), run `mailpit`,
# set MAIL_TRANSPORT=smtp below and open http://localhost:8025.
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@atrium.local

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# The coach and administrator digests run at 00:00 in CENTRE_TIMEZONE, not in
# UTC and not in the server's local zone. An hourly job also closes out
# sessions whose end time has passed.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=stub   deterministic, no model required. Tests and the default
#                       setup use this; every answer still comes from a
#                       permission-filtered query executed as the caller.
# MODEL_PROVIDER=ollama phrases those same answers with a local model. Only
#                       localhost base URLs are accepted, and the model
#                       receives the already-filtered answer, never the data
#                       behind it.
MODEL_PROVIDER=stub
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.2:3b
MODEL_API_KEY=
